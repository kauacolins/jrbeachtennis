// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  OPERATOR
  INTRUCTOR
  ADMIN
}

enum StatusReserva {
  PENDENTE_PAGAMENTO // reserva de autoatendimento aguardando o Pix cair (ver criarReserva)
  CONFIRMADA
  CANCELADA
  CONCLUIDA
  NAO_COMPARECEU
}

model Modalidade {
  id         String      @id @default(cuid())
  nome       String      @unique // Beach tennis, Futebol, Vôlei...
  quadras    Quadra[] // muitos-para-muitos
  reservas   Reserva[]
  categorias Categoria[]
}

model Quadra {
  id                String                 @id @default(cuid())
  nome              String
  descricao         String?
  fotoUrl           String?
  precoHoraCentavos Int
  ativa             Boolean                @default(true)
  modalidades       Modalidade[] // muitos-para-muitos
  horarios          HorarioFuncionamento[]
  bloqueios         Bloqueio[]
  reservas          Reserva[]
}

model HorarioFuncionamento {
  id        String @id @default(cuid())
  quadraId  String
  quadra    Quadra @relation(fields: [quadraId], references: [id])
  diaSemana Int // 0 = domingo ... 6 = sábado
  abreMin   Int // minutos desde 00:00, ex.: 480 = 08:00
  fechaMin  Int // ex.: 1380 = 23:00

  @@unique([quadraId, diaSemana])
}

// RF12: bloqueio pontual de horário (manutenção, evento, feriado, day use).
// Ocupa a agenda do admin do mesmo jeito que uma reserva, mas sem cliente.
model Bloqueio {
  id        String   @id @default(cuid())
  quadraId  String
  quadra    Quadra   @relation(fields: [quadraId], references: [id])
  inicio    DateTime // UTC
  fim       DateTime // UTC
  motivo    String?
  torneioId String? // bloqueio de quadra pro torneio (ver docs/TORNEIOS.md)
  torneio   Torneio? @relation(fields: [torneioId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([quadraId, inicio])
  @@index([torneioId])
}

model Reserva {
  id              String        @id @default(cuid())
  quadraId        String
  quadra          Quadra        @relation(fields: [quadraId], references: [id])
  modalidadeId    String // precisa ser uma das modalidades da quadra
  modalidade      Modalidade    @relation(fields: [modalidadeId], references: [id])
  userId          String? // nulo em reserva manual sem conta
  user            User?         @relation(fields: [userId], references: [id])
  clienteId       String? // reserva manual: cadastro do balcão escolhido na Nova reserva
  cliente         Cliente?      @relation(fields: [clienteId], references: [id])
  nomeContato     String? // reserva manual
  telefoneContato String?
  inicio          DateTime // UTC
  fim             DateTime // UTC
  valorCentavos   Int // preço congelado
  status          StatusReserva @default(CONFIRMADA)
  pago            Boolean       @default(false)
  pagamentoId     String?       @unique // id do Payment no Mercado Pago (Pix)
  expiraEm        DateTime? // prazo pro Pix cair; passou disso, não bloqueia mais horário (ver expirarReservasPendentes)
  canceladaEm     DateTime?
  createdAt       DateTime      @default(now())
  itemComanda     ItemComanda? // RF37: paga junto com a comanda

  @@index([quadraId, inicio])
  @@index([userId])
  @@index([clienteId])
}

// Modelos de autenticação no formato que o Better Auth espera
// (https://better-auth.com — e-mail/senha + login Google, RNF02).
// O e-mail é a identidade: Google com e-mail já cadastrado liga à mesma conta.
model User {
  id                   String           @id @default(cuid())
  name                 String
  email                String           @unique
  emailVerified        Boolean          @default(false)
  image                String? // foto do Google
  telefone             String? // contato; pedido no cadastro ou no primeiro acesso via Google
  role                 Role             @default(CLIENT)
  removidoEm           DateTime? // soft delete de conta de equipe (admin/operador/instrutor)
  reservas             Reserva[]
  cliente              Cliente?
  sessions             Session[]
  accounts             Account[]
  inscricoesCriadas    Inscricao[]
  inscricoesComoAtleta AtletaInscrito[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Login com senha (hash fica em password) ou social (Google).
model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String // "credential" (e-mail/senha) ou "google"
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ---------------------------------------------------------------------------
// Balcão: day use, plano mensal e comandas (docs/COMANDAS.md, RF17–RF21,
// RF30–RF38). Tudo pago no local; o operador marca o método.

enum MetodoPagamento {
  DINHEIRO
  PIX
  CARTAO_DEBITO
  CARTAO_CREDITO
}

enum TipoProduto {
  DAY_USE // por pessoa, por dia
  MENSAL // por pessoa, 30 dias
}

// Cadastro simplificado feito no balcão (nome + telefone), sem conta: o User
// do Better Auth exige e-mail. Se a pessoa tiver conta com o mesmo telefone,
// fica ligado a ela (userId).
model Cliente {
  id          String        @id @default(cuid())
  nome        String
  telefone    String?       @unique // só dígitos
  userId      String?       @unique
  user        User?         @relation(fields: [userId], references: [id])
  passes      PasseDayUse[]
  assinaturas Assinatura[]
  reservas    Reserva[]
  createdAt   DateTime      @default(now())

  @@index([nome])
}

// RF17: preço do day use e do mensal, editável pelo admin. Um registro por
// tipo, criado na migration.
model Produto {
  id            String        @id @default(cuid())
  tipo          TipoProduto   @unique
  nome          String
  precoCentavos Int
  duracaoDias   Int? // 30 no mensal
  limiteDiario  Int? // day use: máximo de pessoas por dia; nulo = sem limite
  ativo         Boolean       @default(true)
  passes        PasseDayUse[]
  assinaturas   Assinatura[]
}

// RN10: um passe por cliente por data (checado na transação, não por
// @@unique, pra dar pra lançar de novo depois de cancelar).
model PasseDayUse {
  id            String           @id @default(cuid())
  produtoId     String
  produto       Produto          @relation(fields: [produtoId], references: [id])
  clienteId     String
  cliente       Cliente          @relation(fields: [clienteId], references: [id])
  data          String // "yyyy-MM-dd" em America/Sao_Paulo — é um dia, não um instante
  valorCentavos Int // congelado; 0 quando coberto pelo mensal
  assinaturaId  String?
  assinatura    Assinatura?      @relation(fields: [assinaturaId], references: [id])
  pago          Boolean          @default(false)
  metodo        MetodoPagamento?
  pagoEm        DateTime?
  canceladoEm   DateTime?
  createdAt     DateTime         @default(now())
  itemComanda   ItemComanda?

  @@index([data])
  @@index([clienteId, data])
}

// RN11: ativo = pago, não cancelado e inicio <= agora < fim.
model Assinatura {
  id            String           @id @default(cuid())
  clienteId     String
  cliente       Cliente          @relation(fields: [clienteId], references: [id])
  produtoId     String
  produto       Produto          @relation(fields: [produtoId], references: [id])
  inicio        DateTime // UTC
  fim           DateTime // inicio + duracaoDias
  valorCentavos Int // congelado
  pago          Boolean          @default(false)
  metodo        MetodoPagamento?
  canceladaEm   DateTime?
  passes        PasseDayUse[]
  createdAt     DateTime         @default(now())

  @@index([clienteId, fim])
}

enum TipoItemComanda {
  BAR
  DAY_USE
  RESERVA
}

enum StatusComanda {
  ABERTA
  FECHADA
  CANCELADA
}

// RF30: produtos do bar. Sem estoque — só registra o que foi vendido.
model ProdutoBar {
  id               String        @id @default(cuid())
  nome             String
  categoria        String? // Bebida, Comida...
  precoCentavos    Int
  // Picolé e afins: valor digitado pelo operador a cada lançamento (até
  // R$ 100). precoCentavos fica 0 e não é usado na venda.
  precoDinamico    Boolean       @default(false)
  ativo            Boolean       @default(true)
  // Foto já reduzida no navegador (WebP, até 512 px) e guardada aqui mesmo —
  // o projeto não tem storage de arquivos. Servida por
  // /api/produtos-bar/[id]/foto; fotoAtualizadaEm entra na URL pra
  // invalidar o cache quando a foto muda. Nunca carregar `foto` em listagem.
  foto             Bytes?
  fotoTipo         String?
  fotoAtualizadaEm DateTime?
  itens            ItemComanda[]
}

// Comanda pelo nome: só o nome digitado pelo operador, sem cadastro.
model Comanda {
  id            String           @id @default(cuid())
  nome          String
  status        StatusComanda    @default(ABERTA)
  totalCentavos Int              @default(0) // recalculado a cada item
  metodo        MetodoPagamento? // preenchido ao fechar
  abertaEm      DateTime         @default(now())
  fechadaEm     DateTime?
  itens         ItemComanda[]

  @@index([status, nome])
  @@index([abertaEm])
}

// O campo certo por tipo é garantido por uma CHECK na migration
// (item_tipo_ok); os @unique impedem passe/reserva em duas comandas.
model ItemComanda {
  id                    String          @id @default(cuid())
  comandaId             String
  comanda               Comanda         @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  tipo                  TipoItemComanda @default(BAR)
  descricao             String // "Água", "Day use", "Quadra 2 · 19:00–20:00"
  produtoId             String? // só BAR
  produto               ProdutoBar?     @relation(fields: [produtoId], references: [id])
  passeId               String?         @unique // só DAY_USE
  passe                 PasseDayUse?    @relation(fields: [passeId], references: [id])
  reservaId             String?         @unique // só RESERVA
  reserva               Reserva?        @relation(fields: [reservaId], references: [id])
  quantidade            Int             @default(1)
  precoUnitarioCentavos Int // congelado no lançamento
  createdAt             DateTime        @default(now())

  @@index([comandaId])
}

// ---------------------------------------------------------------------------
// Opções de select editáveis no banco, agrupadas por chave (ex.:
// "categoria_produto" → Bebida, Comida). Quem usa guarda o `nome` da opção
// como texto (ex.: ProdutoBar.categoria), então desativar uma opção não
// apaga o que já foi salvo com ela.

model SelectGroup {
  id     String         @id @default(cuid())
  chave  String         @unique // usada no código, ex.: "categoria_produto"
  nome   String // rótulo legível, ex.: "Categoria de produto"
  opcoes SelectOption[]
}

model SelectOption {
  id      String      @id @default(cuid())
  grupoId String
  grupo   SelectGroup @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nome    String
  ordem   Int         @default(0)
  ativo   Boolean     @default(true)

  @@unique([grupoId, nome])
}

// ---------------------------------------------------------------------------
// Campeonatos e torneios (docs/TORNEIOS.md). Primeira etapa: cadastro do
// torneio, categorias e bloqueio das quadras. Inscrição pelo site e lista de
// inscritos (Inscricao/AtletaInscrito) ficam para a próxima etapa.

enum StatusTorneio {
  RASCUNHO // só o admin vê
  INSCRICOES_ABERTAS
  INSCRICOES_ENCERRADAS
  EM_ANDAMENTO
  FINALIZADO
  CANCELADO
}

model Torneio {
  id                  String        @id @default(cuid())
  slug                String        @unique // "beneficente-2026"
  nome                String
  descricao           String? // regulamento, premiação, kit
  doacao              String? // ex.: "1 kg de alimento não perecível"
  bannerUrl           String? // banner horizontal (home e topo da página do torneio), no Vercel Blob
  destaqueHome        Boolean       @default(false) // mostrar o banner na home
  destaqueAte         DateTime? // some da home depois disso; vazio = até dataFim
  dataInicio          DateTime      @db.Date
  dataFim             DateTime      @db.Date
  inscricoesAbrem     DateTime
  inscricoesFecham    DateTime
  maxCategoriasAtleta Int?          @default(2) // vazio = sem limite
  status              StatusTorneio @default(RASCUNHO)
  categorias          Categoria[]
  bloqueios           Bloqueio[] // quadras reservadas para o torneio
  createdAt           DateTime      @default(now())
}

model Categoria {
  id             String      @id @default(cuid())
  torneioId      String
  torneio        Torneio     @relation(fields: [torneioId], references: [id], onDelete: Cascade)
  modalidadeId   String
  modalidade     Modalidade  @relation(fields: [modalidadeId], references: [id])
  nome           String // "Dupla Masc. C", "Simples Feminino D", "Livre"
  minAtletas     Int         @default(1)
  maxAtletas     Int         @default(1) // 2 na dupla; ex.: 12 no futebol
  valorCentavos  Int // por inscrição
  vagas          Int? // nº máximo de inscrições
  inicioPrevisto DateTime? // programação prévia
  ordem          Int         @default(0) // ordem de exibição
  inscricoes     Inscricao[]

  @@unique([torneioId, nome])
}

enum StatusInscricao {
  PENDENTE // aguardando pagamento, sem prazo — segura a vaga até confirmar ou cancelar
  CONFIRMADA // paga
  CANCELADA
}

// Uma inscrição = um atleta, uma dupla ou um time, dependendo de
// minAtletas/maxAtletas da categoria.
model Inscricao {
  id            String           @id @default(cuid())
  categoriaId   String
  categoria     Categoria        @relation(fields: [categoriaId], references: [id])
  criadaPorId   String // quem fez a inscrição e paga
  criadaPor     User             @relation(fields: [criadaPorId], references: [id])
  nomeEquipe    String? // só para times
  valorCentavos Int // preço congelado
  status        StatusInscricao  @default(PENDENTE)
  pagoEm        DateTime?
  atletas       AtletaInscrito[]
  createdAt     DateTime         @default(now())

  @@index([categoriaId, status])
}

model AtletaInscrito {
  id          String    @id @default(cuid())
  inscricaoId String
  inscricao   Inscricao @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  userId      String? // nulo para quem não tem conta
  user        User?     @relation(fields: [userId], references: [id])
  nome        String
  celular     String // só dígitos; usado para checar duplicidade e limite por atleta

  @@index([celular])
}

// ---------------------------------------------------------------------------
// Avisos do admin (aula, manutenção, evento do dia...) mostrados no modal de
// entrada do site, junto com torneios de inscrição aberta (ver
// listarEventosAtivos). Sem exclusão em cascata: evento não referencia nada.

model Evento {
  id                 String    @id @default(cuid())
  titulo             String
  resumo             String? // linha curta no modal; vazio = usa início da descrição
  descricao          String? // texto completo na página de detalhe
  data               DateTime? // dia/hora do evento, só exibição (ex.: "hoje às 19h")
  exibicaoInicio     DateTime? // a partir de quando aparece no modal (início do dia); vazio = desde já
  exibicaoFim        DateTime? // até quando aparece no modal (fim do dia); vazio = até desativar
  imagem             Bytes?
  imagemTipo         String?
  imagemAtualizadaEm DateTime?
  ativo              Boolean   @default(true)
  ordem              Int       @default(0)
  createdAt          DateTime  @default(now())
}
