DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jrbeachtennis?schema=public"

# Better Auth (RNF02) — login com e-mail/senha e Google.
# Gere um valor novo com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Credenciais do Google Cloud Console (OAuth 2.0 Client ID, tipo "Web application").
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
# Sem essas duas variáveis, o login com Google fica desativado e só
# e-mail/senha funciona.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mercado Pago (pagamento via Pix na reserva) — painel de desenvolvedores:
# https://www.mercadopago.com.br/developers/panel > Suas integrações >
# [sua aplicação] > Credenciais de teste. Desde a mudança do painel em
# 2026, essas credenciais TAMBÉM começam com "APP_USR-" (não mais
# "TEST-") — o que diferencia teste de produção é a aba de onde você
# copiou, não mais o prefixo. Use sempre as de teste em desenvolvimento.
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Segredo da assinatura do webhook (painel > [sua aplicação] > Webhooks >
# Configurar notificações > "Chave secreta"). Sem ele, o endpoint do
# webhook recusa qualquer notificação (RNF: nunca confiar em payload de
# webhook sem validar a assinatura).
MERCADOPAGO_WEBHOOK_SECRET=""

# Só em desenvolvimento: e-mail de um usuário de teste COMPRADOR criado
# no painel (Suas integrações > Contas de teste > Criar usuário de
# teste). Com credencial de teste, o Mercado Pago recusa e-mail
# "inventado" de pagador com "Unauthorized use of live credentials" —
# precisa ser o de uma conta de teste de verdade. Deixe vazio em
# produção (nesse caso o sistema sintetiza um e-mail a partir do
# telefone do cliente, ver criarPagamentoPix).
MERCADOPAGO_TEST_PAYER_EMAIL=""
